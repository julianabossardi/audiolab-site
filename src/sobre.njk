---
layout: base.njk
title: Sobre · AudioLab
---
{% from "al-macros.njk" import icon, socialIcon, placeholder, equalizer, carouselControls %}
{% set filtros = [["todos", "Todos"], ["audiolab", "Equipe do laboratório"]] %}
{% for proj in projetos %}{% set filtros = (filtros.push([proj.slug, proj.nome]), filtros) %}{% endfor %}
{% set filtros = (filtros.push(["jonami", "JONAMI"]), filtros) %}

<!-- herói alinhado à esquerda, como as demais páginas -->
<section class="page-hero">
  <div class="wrap page-hero-inner">
    <nav class="breadcrumb" aria-label="Trilha"><a href="/">AudioLab</a> · <span aria-current="page">Sobre</span></nav>
    <h1>Conheça o AudioLab</h1>
    {% if laboratorio.lab_descricao_curta %}<p class="lead">{{ laboratorio.lab_descricao_curta }}</p>{% endif %}
  </div>
  {{ equalizer(56, "md") }}
</section>

<!-- história -->
{% if sobre.historia_1 or sobre.historia_2 %}
<section class="section" aria-labelledby="titulo-historia">
  <div class="wrap sobre-historia">
    <div class="prose">
      <h2 class="section-title" id="titulo-historia"><span class="al-section-marker" aria-hidden="true"></span>Nossa história</h2>
      {% if sobre.historia_1 %}<p data-reveal="up">{{ sobre.historia_1 }}</p>{% endif %}
      {% if sobre.historia_2 %}<p data-reveal="up" style="--i: 1;">{{ sobre.historia_2 }}</p>{% endif %}
    </div>
    <div class="sobre-historia-photos">
      <div class="sobre-photo-back framed" data-reveal="up">
        {% if sobre.foto_antiga | img %}<img src="{{ sobre.foto_antiga | img }}" alt="Equipe do AudioLab em foto antiga" />{% else %}{{ placeholder("[imagem 4:3]", "4-3") }}{% endif %}
      </div>
      <div class="sobre-photo-front framed" data-reveal="up" style="--i: 1;">
        {% if sobre.foto_recente | img %}<img src="{{ sobre.foto_recente | img }}" alt="Equipe do AudioLab em foto recente" />{% else %}{{ placeholder("[imagem 4:3]", "4-3") }}{% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- números: só os marcados USAR NO SITE na planilha -->
{% if laboratorio.estatisticas.length %}
<section class="section" aria-labelledby="titulo-numeros">
  <div class="wrap">
    <h2 class="al-visually-hidden" id="titulo-numeros">O AudioLab em números</h2>
    <ul class="stat-band" style="--n: {{ laboratorio.estatisticas.length }};">
      {% for s in laboratorio.estatisticas %}
      <li class="stat" data-reveal="up" style="--i: {{ loop.index0 }};">
        <span class="stat-num" data-count>{{ s.numero }}</span>
        <span class="stat-label">{{ s.rotulo }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

<!-- método -->
{% if laboratorio.lab_metodologia or laboratorio.lab_udt %}
<section class="section" aria-labelledby="titulo-metodo">
  <div class="wrap">
    <h2 class="section-title" id="titulo-metodo"><span class="al-section-marker" aria-hidden="true"></span>Como trabalhamos</h2>
    <div class="info-grid">
      {% if laboratorio.lab_metodologia %}
      <div class="info-card" data-reveal="up">
        <h3>Ludens narrativo</h3>
        <p>{{ laboratorio.lab_metodologia }}</p>
      </div>
      {% endif %}
      {% if laboratorio.lab_udt %}
      <div class="info-card" data-reveal="up" style="--i: 1;">
        <h3>Unidade de Desenvolvimento Tecnológico</h3>
        <p>{{ laboratorio.lab_udt }}</p>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<!-- premiações -->
{% if laboratorio.premios.length %}
<section class="section" aria-labelledby="titulo-premios">
  <div class="wrap">
    <h2 class="section-title" id="titulo-premios"><span class="al-section-marker" aria-hidden="true"></span>Premiações e reconhecimentos</h2>
    <ul class="award-list">
      {% for premio in laboratorio.premios %}
      <li data-reveal="up" style="--i: {{ loop.index0 % 4 }};">{{ premio }}</li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

<!-- Revista AudioLab: vitrine do laboratório -->
{% if laboratorio.revista_o_que_e %}
<section class="section" aria-labelledby="titulo-revista">
  <div class="wrap">
    <div class="feature-band">
      <div class="feature-band-text">
        <h2 id="titulo-revista">Revista AudioLab</h2>
        <p>{{ laboratorio.revista_o_que_e }}</p>
        {% if laboratorio.revista_historia %}<p>{{ laboratorio.revista_historia }}</p>{% endif %}
        {% if laboratorio.revista_onde_ouvir %}<p class="feature-band-note">Onde ouvir: {{ laboratorio.revista_onde_ouvir }}</p>{% endif %}
        {% if laboratorio.revista_link_spotify %}
        <a class="btn btn-primary" href="{{ laboratorio.revista_link_spotify }}" target="_blank" rel="noopener">{{ socialIcon("spotify", 18) }}Ouça no Spotify</a>
        {% endif %}
      </div>
      {% if laboratorio.revista_estatisticas.length %}
      <ul class="feature-band-stats">
        {% for s in laboratorio.revista_estatisticas %}
        <li><span class="stat-num" data-count>{{ s.numero }}</span><span class="stat-label">{{ s.rotulo }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<!-- RadioTube: bloco próprio, discreto, para marcar o lugar na hierarquia -->
{% if laboratorio.lab_radiotube %}
<section class="section" aria-labelledby="titulo-radiotube">
  <div class="wrap">
    <div class="radiotube">
      <span class="radiotube-icon" aria-hidden="true">{{ icon("ao-vivo", 32) }}</span>
      <div class="radiotube-text">
        <span class="eyebrow">Rádios comunitárias</span>
        <h2 id="titulo-radiotube">Nossos programas no RadioTube</h2>
        <p>{{ laboratorio.lab_radiotube }}</p>
      </div>
      {% if laboratorio.lab_link_radiotube %}
      <a class="btn btn-secondary" href="{{ laboratorio.lab_link_radiotube }}" target="_blank" rel="noopener">Perfil do AudioLab no RadioTube {{ icon("link-externo", 18) }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<!-- valores -->
{% if sobre.valores.length %}
<section class="section" aria-labelledby="titulo-valores">
  <div class="wrap sobre-valores">
    <div class="sobre-valores-photo framed" data-reveal="up">
      {% if sobre.foto_uerj | img %}<img src="{{ sobre.foto_uerj | img }}" alt="Campus da UERJ" />{% else %}{{ placeholder("[imagem 4:3]", "4-3") }}{% endif %}
    </div>
    <div>
      <h2 class="section-title" id="titulo-valores"><span class="al-section-marker" aria-hidden="true"></span>Queremos uma UERJ +</h2>
      <ul class="valores-list">
        {% for v in sobre.valores %}
        <li data-reveal="up" style="--i: {{ loop.index0 }};">{{ v }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
{% endif %}

<!-- fotos -->
{% if sobre.carrossel_fotos.length %}
<section class="section" aria-labelledby="titulo-fotos" data-carousel aria-roledescription="carrossel">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title" id="titulo-fotos"><span class="al-section-marker" aria-hidden="true"></span>Um pouco da nossa história</h2>
      {{ carouselControls("Fotos") }}
    </div>
  </div>
  <ul class="photo-carousel" data-carousel-track>
    {% for item in sobre.carrossel_fotos %}
    <li>
      {% if item.foto | img %}
      <button type="button" class="photo-carousel-item framed" data-lightbox-item data-caption="{{ item.legenda }}" aria-label="Ampliar foto {{ loop.index }}{% if item.legenda %}: {{ item.legenda }}{% endif %}">
        <img src="{{ item.foto | img }}" alt="" />
      </button>
      {% else %}
      <div class="photo-carousel-item">{{ placeholder("[imagem 4:3]", "4-3") }}</div>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  <div class="modal-overlay lightbox" id="sobreLightbox" role="dialog" aria-modal="true" aria-label="Foto ampliada" hidden>
    <button type="button" class="modal-close" data-close-lightbox aria-label="Fechar">{{ icon("fechar", 20) }}</button>
    <figure class="lightbox-body">
      <img id="sobreLightboxImg" src="data:," alt="" />
      <figcaption id="sobreLightboxCaption"></figcaption>
    </figure>
  </div>
</section>
{% endif %}

<!-- CTA: participação -->
<section class="section" id="participe" aria-labelledby="titulo-participe">
  <div class="wrap">
    <div class="cta-band">
      <div class="cta-band-text">
        <h2 id="titulo-participe">Quer participar?</h2>
        <p>Abrimos inscrições anualmente: fique de olho nas nossas redes sociais para entrar como bolsista, ou nos mande uma mensagem para atuar como voluntário.</p>
      </div>
      <div class="cta-band-actions">
        {% if laboratorio.lab_link_instagram %}
        <a class="btn btn-primary" href="{{ laboratorio.lab_link_instagram }}" target="_blank" rel="noopener">{{ socialIcon("instagram", 18) }}Seguir no Instagram</a>
        {% endif %}
        {% if laboratorio.lab_email %}
        <a class="btn btn-on-dark" href="mailto:{{ laboratorio.lab_email }}">{{ icon("email", 18) }}Quero ser voluntário</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<!-- quem faz parte -->
{% if publicacao.pessoas and pessoas.length %}
<section class="section" id="equipe" aria-labelledby="titulo-equipe">
  <div class="wrap">
    <h2 class="section-title" id="titulo-equipe"><span class="al-section-marker" aria-hidden="true"></span>Quem faz parte</h2>
    <div class="chips" role="group" aria-label="Filtrar por projeto">
      {% for f in filtros %}
      <button type="button" class="chip" data-filtro="{{ f[0] }}" aria-pressed="{{ 'true' if f[0] == 'todos' else 'false' }}" aria-controls="lista-equipe">{{ f[1] }}</button>
      {% endfor %}
    </div>
    <ul class="people-grid people-grid--text" id="lista-equipe">
      {% for m in pessoas %}
      {% set todos = "Todos os projetos" in m.projetos %}
      {% set etiquetas = ["Todos os projetos"] if todos else m.projetos %}
      <li class="person person--text" data-projetos="{% for x in m.projetos %}{{ x | slugify }} {% endfor %}"{% if todos %} data-todos{% endif %}>
        <h3 class="person-name">{{ m.nome }}</h3>
        {% if m.funcao %}<p class="person-role">{{ m.funcao }}</p>{% endif %}
        {% if etiquetas.length %}
        <ul class="person-tags" aria-label="Projetos">
          {% for x in etiquetas | limit(2) %}
          <li class="person-tag"{% if x != "Todos os projetos" and x != "AudioLab" and x != "JONAMI" %} data-project="{{ (x | brand).key }}"{% endif %}>{{ x }}</li>
          {% endfor %}
          {% if etiquetas.length > 2 %}<li class="person-tag person-tag--more" title="{{ etiquetas.slice(2).join(', ') }}"><span aria-hidden="true">+{{ etiquetas.length - 2 }}</span><span class="al-visually-hidden">{{ etiquetas.slice(2).join(", ") }}</span></li>{% endif %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="empty-state" id="equipe-vazia" hidden>Nenhuma pessoa cadastrada neste projeto ainda.</p>
  </div>
</section>
{% endif %}

<script>
(function () {
  // Fotos: ampliação com legenda (a rolagem vem de carousel-script.njk).
  var carousel = document.querySelector(".photo-carousel");
  if (carousel) {

    var lightbox = document.getElementById("sobreLightbox");
    var img = document.getElementById("sobreLightboxImg");
    var caption = document.getElementById("sobreLightboxCaption");
    var trigger = null;
    function close() { lightbox.hidden = true; if (trigger) trigger.focus(); }
    carousel.querySelectorAll("[data-lightbox-item]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        trigger = btn;
        img.src = btn.querySelector("img").src;
        caption.textContent = btn.getAttribute("data-caption") || "";
        caption.hidden = !caption.textContent;
        lightbox.hidden = false;
        lightbox.querySelector("[data-close-lightbox]").focus();
      });
    });
    lightbox.querySelector("[data-close-lightbox]").addEventListener("click", close);
    lightbox.addEventListener("click", function (e) { if (e.target === lightbox) close(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !lightbox.hidden) close(); });
  }

  // Quem faz parte: filtro por projeto, também pelo parâmetro ?projeto=.
  var lista = document.getElementById("lista-equipe");
  if (!lista) return;
  var chips = document.querySelectorAll("[data-filtro]");
  var pessoas = lista.querySelectorAll(".person");
  var vazio = document.getElementById("equipe-vazia");
  var especiais = { audiolab: true, jonami: true };

  function filtrar(valor, atualizarUrl) {
    var existe = Array.prototype.some.call(chips, function (c) { return c.getAttribute("data-filtro") === valor; });
    if (!existe) valor = "todos";
    chips.forEach(function (c) { c.setAttribute("aria-pressed", String(c.getAttribute("data-filtro") === valor)); });
    var visiveis = 0;
    pessoas.forEach(function (p) {
      var projetos = (p.getAttribute("data-projetos") || "").split(" ");
      var mostra = valor === "todos" || projetos.indexOf(valor) !== -1 || (!especiais[valor] && p.hasAttribute("data-todos"));
      p.hidden = !mostra;
      if (mostra) visiveis++;
    });
    vazio.hidden = visiveis > 0;
    if (atualizarUrl && window.history.replaceState) {
      var url = new URL(window.location.href);
      if (valor === "todos") url.searchParams.delete("projeto"); else url.searchParams.set("projeto", valor);
      url.hash = "equipe";
      window.history.replaceState(null, "", url);
    }
  }
  chips.forEach(function (c) { c.addEventListener("click", function () { filtrar(c.getAttribute("data-filtro"), true); }); });
  var inicial = new URLSearchParams(window.location.search).get("projeto");
  if (inicial) filtrar(inicial, false);
})();
</script>
