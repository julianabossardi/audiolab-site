---
layout: base.njk
pagination:
  data: projetos
  size: 1
  alias: p
permalink: "/projetos/{{ p.slug }}/"
eleventyComputed:
  title: "{{ p.nome }} · AudioLab"
  description: "{{ p.tagline }}"
---
{% from "al-macros.njk" import icon, socialIcon, placeholder, equalizer %}
{% set b = p.nome | brand %}
{% set logoHeroi = (p.logo | img) or b.logoBranco or b.logo %}
{% set email = p.email or laboratorio.lab_email %}
{% set sobreTexto = p.o_que_e or p.historia_contexto %}
{% set equipe = (pessoas | pessoasDoProjeto(p.nome) | limit(6)) if publicacao.pessoas else [] %}
{% set video = p.video | youtubeEmbed %}
{% set noticiasDoProjeto = noticias | relatedNoticias(p.slug) %}
{% set redesProjeto = [
  ["instagram", "Instagram", p.redes.instagram],
  ["spotify", "Spotify", p.redes.spotify],
  ["amazon_music", "Amazon Music", p.redes.amazon_music],
  ["youtube", "YouTube", p.redes.youtube],
  ["tiktok", "TikTok", p.redes.tiktok]
] %}
{% set temRedes = p.redes.instagram or p.redes.spotify or p.redes.amazon_music or p.redes.youtube or p.redes.tiktok %}

<div data-project="{{ b.key }}">

  <!-- herói: mesma estrutura em todo projeto, só a cor muda -->
  <section class="proj-hero">
    <div class="wrap proj-hero-grid">
      <div class="proj-hero-text">
        <nav class="breadcrumb" aria-label="Trilha">
          <a href="/">AudioLab</a>{{ icon("seta-direita", 14) }}<a href="/projetos/">Projetos</a>{{ icon("seta-direita", 14) }}<span aria-current="page">{{ p.nome }}</span>
        </nav>
        {% if p.tag %}<span class="proj-hero-tag">{{ p.tag }}</span>{% endif %}
        <h1>{{ p.nome }}</h1>
        {% if p.tagline %}<p class="lead">{{ p.tagline }}</p>{% endif %}
        <div class="proj-hero-actions">
          {% if p.conteudos.length %}
          <a class="btn btn-primary" href="#episodios">{{ icon("play", 18) }}Ouça os episódios</a>
          {% elif p.quadros.length %}
          <a class="btn btn-primary" href="#series">{{ icon("fones", 18) }}Conheça as séries</a>
          {% elif video %}
          <a class="btn btn-primary" href="#video">{{ icon("play", 18) }}Assista ao vídeo</a>
          {% elif p.redes.youtube %}
          <a class="btn btn-primary" href="{{ p.redes.youtube }}" target="_blank" rel="noopener">{{ icon("play", 18) }}Assista no YouTube</a>
          {% endif %}
          {% if equipe.length %}
          <a class="btn btn-on-dark" href="#equipe">{{ icon("pessoas", 18) }}Conheça a equipe</a>
          {% elif p.redes.instagram %}
          <a class="btn btn-on-dark" href="{{ p.redes.instagram }}" target="_blank" rel="noopener">{{ socialIcon("instagram", 18) }}Siga no Instagram</a>
          {% endif %}
        </div>
      </div>
      <!-- imagem principal: logo em branco, sem fundo; sem logo, a sigla -->
      <div class="proj-hero-art" aria-hidden="true">
        {% if logoHeroi %}<img src="{{ logoHeroi }}" alt="" />{% else %}<span class="proj-hero-sigla">{{ b.sigla }}</span>{% endif %}
      </div>
    </div>
    {{ equalizer(56, "md") }}
  </section>

  <!-- abas: só as das seções que existem neste projeto -->
  <nav class="proj-tabs" aria-label="Seções do projeto">
    <div class="wrap proj-tabs-list">
      <a href="#sobre">{{ "Sobre" if sobreTexto else "Ficha" }}</a>
      {% if p.quadros.length %}<a href="#series">Séries</a>{% endif %}
      {% if video %}<a href="#video">Vídeo</a>{% endif %}
      {% if p.conteudos.length %}<a href="#episodios">Episódios</a>{% endif %}
      {% if noticiasDoProjeto.length %}<a href="#noticias">Notícias</a>{% endif %}
      {% if equipe.length %}<a href="#equipe">Equipe</a>{% endif %}
      <a href="#contato">Contato</a>
    </div>
  </nav>

  <!-- sobre + ficha -->
  <section class="section" id="sobre">
    <div class="wrap">
      <div class="proj-about{% if not sobreTexto %} is-ficha-only{% endif %}">
        {% if sobreTexto %}
        <div class="prose">
          <h2 class="section-title"><span class="al-section-marker" aria-hidden="true"></span>Sobre {{ p.nome | comArtigo }}</h2>
          {% if p.o_que_e %}<p>{{ p.o_que_e }}</p>{% endif %}
          {% if p.historia_contexto %}<p>{{ p.historia_contexto }}</p>{% endif %}
        </div>
        {% endif %}

        <aside class="proj-ficha" aria-labelledby="ficha-titulo">
          <h2 class="proj-ficha-title" id="ficha-titulo">Ficha do projeto</h2>
          <dl>
            {% if p.coordenacao %}<div><dt>{{ icon("pessoas", 16) }}Coordenação</dt><dd>{{ p.coordenacao }}</dd></div>{% endif %}
            {% if p.ano_inicio %}<div><dt>{{ icon("calendario", 16) }}Início</dt><dd>{{ p.ano_inicio }}</dd></div>{% endif %}
            <div><dt>{{ icon("email", 16) }}E-mail</dt><dd><a href="mailto:{{ email }}">{{ email }}</a></dd></div>
          </dl>
          {% if temRedes %}
          <ul class="proj-redes" aria-label="Redes {{ 'da' if b.artigo == 'a' else 'do' }} {{ p.nome }}">
            {% for r in redesProjeto %}{% if r[2] %}
            <li><a href="{{ r[2] }}" target="_blank" rel="noopener">{{ socialIcon(r[0], 20) }}<span>{{ r[1] }}</span></a></li>
            {% endif %}{% endfor %}
          </ul>
          {% endif %}
        </aside>
      </div>

      {% if p.estatisticas.length %}
      <ul class="stat-band" style="--n: {{ p.estatisticas.length }};" aria-label="Números">
        {% for s in p.estatisticas %}
        <li class="stat" data-reveal="up" style="--i: {{ loop.index0 }};">
          <span class="stat-num" data-count>{{ s.numero }}</span>
          <span class="stat-label">{{ s.rotulo }}</span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </section>

  <!-- séries: accordion, nome sempre visível -->
  {% if p.quadros.length %}
  <section class="section" id="series">
    <div class="wrap">
      <h2 class="section-title"><span class="al-section-marker" aria-hidden="true"></span>Séries</h2>
      <ul class="accordion">
        {% for q in p.quadros %}
        {% set qid = "serie-" + loop.index %}
        <li class="accordion-item">
          <h3 class="accordion-heading">
            <button type="button" class="accordion-btn" aria-expanded="false" aria-controls="{{ qid }}" data-accordion>
              <span>{{ q.nome }}</span>{{ icon("mais", 20) }}
            </button>
          </h3>
          <div class="accordion-panel" id="{{ qid }}" hidden>
            {% if q.imagem | img %}<img class="accordion-img" src="{{ q.imagem | img }}" alt="" />{% endif %}
            {% if q.descricao %}<p>{{ q.descricao }}</p>{% endif %}
            {% if q.link %}<a class="link-arrow" href="{{ q.link }}" target="_blank" rel="noopener">Ver a série {{ icon("link-externo", 16) }}</a>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <!-- vídeo em destaque: sem cookies e sem reprodução automática -->
  {% if video %}
  <section class="section" id="video">
    <div class="wrap">
      <h2 class="section-title"><span class="al-section-marker" aria-hidden="true"></span>Vídeo em destaque</h2>
      <div class="video-frame">
        <iframe src="{{ video }}" title="Vídeo {{ 'da' if b.artigo == 'a' else 'do' }} {{ p.nome }} no YouTube" loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- episódios e conteúdos -->
  {% if p.conteudos.length %}
  <section class="section" id="episodios">
    <div class="wrap">
      <h2 class="section-title"><span class="al-section-marker" aria-hidden="true"></span>Episódios e conteúdos</h2>
      {% set conteudos = p.conteudos | ordenarConteudos %}
      <ol class="episode-list" id="lista-episodios"{% if conteudos.length > 5 %} data-paginar="5"{% endif %}>
        {% for c in conteudos %}
        <li>
          {% if c.link %}
          <a class="episode-row" href="{{ c.link }}" target="_blank" rel="noopener">
            <span class="episode-num" aria-hidden="true">{{ loop.index }}</span>
            <span class="episode-title">{{ c.titulo }}{% if c.data %}<span class="episode-date">{{ c.data }}</span>{% endif %}</span>
            {{ icon("link-externo", 20) }}
          </a>
          {% else %}
          <span class="episode-row">
            <span class="episode-num" aria-hidden="true">{{ loop.index }}</span>
            <span class="episode-title">{{ c.titulo }}{% if c.data %}<span class="episode-date">{{ c.data }}</span>{% endif %}</span>
          </span>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
      {% if conteudos.length > 5 %}<nav class="pagination" aria-label="Páginas de episódios" data-paginacao="lista-episodios" hidden></nav>{% endif %}
    </div>
  </section>
  {% endif %}

  <!-- notícias ligadas ao projeto -->
  {% if noticiasDoProjeto.length %}
  <section class="section" id="noticias">
    <div class="wrap">
      <h2 class="section-title"><span class="al-section-marker" aria-hidden="true"></span>Notícias</h2>
      <ul class="news-mini-grid">
        {% for n in noticiasDoProjeto | limit(3) %}
        <li class="news-mini">
          <div class="news-mini-img">{% if n.capa | img %}<img src="{{ n.capa | img }}" alt="" />{% else %}{{ placeholder("[imagem 16:9]") }}{% endif %}</div>
          <h3><a href="{{ n.link if n.link else ('/noticias/' + n.slug + '/') }}"{% if n.link %} target="_blank" rel="noopener"{% endif %}>{{ n.titulo }}</a></h3>
          {% if n.data %}<span class="news-date">{{ n.data | formatDate }}</span>{% endif %}
          <span class="link-arrow" aria-hidden="true">Ler a notícia {{ icon("seta", 16) }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <!-- equipe: até 6 pessoas, em cards de texto com filete na cor do projeto -->
  {% if equipe.length %}
  <section class="section" id="equipe">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title"><span class="al-section-marker" aria-hidden="true"></span>Equipe</h2>
        <a class="link-arrow" href="/sobre/?projeto={{ p.slug }}#equipe">Ver toda a equipe {{ icon("seta", 18) }}</a>
      </div>
      <ul class="people-grid people-grid--text">
        {% for m in equipe %}
        <li class="person person--text">
          <h3 class="person-name">{{ m.nome }}</h3>
          {% if m.funcao %}<p class="person-role">{{ m.funcao }}</p>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <!-- fale com o projeto -->
  <section class="section" id="contato">
    <div class="wrap">
      <div class="cta-band">
        <div class="cta-band-text">
          <h2>Participe</h2>
          {% if p.fale_com_o_projeto %}<p>{{ p.fale_com_o_projeto }}</p>{% endif %}
        </div>
        {% if p.redes.instagram %}
        <a class="btn btn-primary" href="{{ p.redes.instagram }}" target="_blank" rel="noopener">{{ socialIcon("instagram", 18) }}Fale com {{ p.nome | comArtigo }}</a>
        {% else %}
        <a class="btn btn-primary" href="mailto:{{ email }}">{{ icon("email", 18) }}Fale com {{ p.nome | comArtigo }}</a>
        {% endif %}
      </div>
    </div>
  </section>

</div>

<script>
(function () {
  // Episódios: 5 por página. Sem JavaScript, a lista aparece inteira.
  document.querySelectorAll("[data-paginacao]").forEach(function (nav) {
    var lista = document.getElementById(nav.getAttribute("data-paginacao"));
    var itens = Array.prototype.slice.call(lista.children);
    var porPagina = parseInt(lista.getAttribute("data-paginar"), 10) || 5;
    var total = Math.ceil(itens.length / porPagina);
    var atual = 1;
    function botao(rotulo, pagina, extra) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "pagination-btn" + (extra ? " " + extra : "");
      b.innerHTML = rotulo;
      b.addEventListener("click", function () { mostrar(pagina, true); });
      return b;
    }
    function mostrar(pagina, focar) {
      atual = Math.min(Math.max(pagina, 1), total);
      itens.forEach(function (li, i) { li.hidden = Math.floor(i / porPagina) + 1 !== atual; });
      nav.innerHTML = "";
      var ant = botao("<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M16 5v14L5 12z\"></path></svg>", atual - 1, "pagination-arrow");
      ant.setAttribute("aria-label", "Página anterior");
      ant.disabled = atual === 1;
      nav.appendChild(ant);
      for (var n = 1; n <= total; n++) {
        var b = botao(String(n), n);
        b.setAttribute("aria-label", "Página " + n);
        if (n === atual) b.setAttribute("aria-current", "page");
        nav.appendChild(b);
      }
      var prox = botao("<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"></path></svg>", atual + 1, "pagination-arrow");
      prox.setAttribute("aria-label", "Próxima página");
      prox.disabled = atual === total;
      nav.appendChild(prox);
      if (focar) {
        var alvo = nav.querySelector("[aria-current]");
        if (alvo) alvo.focus();
      }
    }
    nav.hidden = false;
    mostrar(1, false);
  });

  document.querySelectorAll("[data-accordion]").forEach(function (btn) {
    var panel = document.getElementById(btn.getAttribute("aria-controls"));
    btn.addEventListener("click", function () {
      var open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      panel.hidden = open;
    });
  });
})();
</script>
