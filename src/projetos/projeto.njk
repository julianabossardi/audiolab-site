---
layout: base.njk
pagination:
  data: projetos
  size: 1
  alias: p
permalink: "/projetos/{{ p.slug }}/"
eleventyComputed:
  title: "{{ p.nome }} — AudioLab"
---
<a class="back-link" href="/">‹ AudioLab</a>

{% if p.capa %}<img class="cover" src="{{ p.capa }}" alt="" />{% endif %}
{% if p.tag %}<span class="tag-pill">{{ p.tag }}</span>{% endif %}
<h1>{{ p.nome }}</h1>
<p class="lead">{{ p.tagline }}</p>

{% if p.estatisticas.length %}
<div class="stat-row">
  {% for s in p.estatisticas %}
  <div class="stat"><b>{{ s.numero }}</b><span>{{ s.rotulo }}</span></div>
  {% endfor %}
</div>
{% endif %}

{% if p.video %}
<p><a class="btn" href="{{ p.video }}" target="_blank" rel="noopener">▶ assistir vídeo</a></p>
{% endif %}

{% if p.descricao %}
<div>{{ p.descricao | safe }}</div>
{% endif %}

{% if p.conteudos.length %}
<h3>Conteúdos</h3>
<ul class="plain">
  {% for c in p.conteudos %}
  <li>
    {% if c.link %}<a href="{{ c.link }}" target="_blank" rel="noopener">{{ c.titulo }}</a>{% else %}{{ c.titulo }}{% endif %}
  </li>
  {% endfor %}
</ul>
{% endif %}
