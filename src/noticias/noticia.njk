---
layout: base.njk
pagination:
  data: noticias
  size: 1
  alias: n
permalink: "/noticias/{{ n.slug }}/"
eleventyComputed:
  title: "{{ n.titulo }} · AudioLab"
  description: "{{ n.subtitulo or (n.corpo | resumo) }}"
  image: "{{ n.capa | img }}"
  ogTipo: "article"
  publicado: "{{ n.data }}"
---
{% from "al-macros.njk" import icon, socialIcon, placeholder %}
{% set capa = n.capa | img %}
{% set projeto = null %}
{% for p in projetos %}{% if p.slug == n.projeto_relacionado %}{% set projeto = p %}{% endif %}{% endfor %}

<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      "headline": n.titulo | resumo(110),
      "description": n.subtitulo or (n.corpo | resumo),
      "image": [capa if capa.startsWith("http") else site.url + capa] if capa else undefined,
      "datePublished": n.data or undefined,
      "dateModified": n.data or undefined,
      "inLanguage": "pt-BR",
      "mainEntityOfPage": site.url + "/noticias/" + n.slug + "/",
      "author": { "@id": site.url + "/#organizacao" },
      "publisher": { "@id": site.url + "/#organizacao" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "AudioLab", "item": site.url + "/" },
        { "@type": "ListItem", "position": 2, "name": "Notícias", "item": site.url + "/noticias/" },
        { "@type": "ListItem", "position": 3, "name": n.titulo }
      ]
    }
  ]
} | json | safe }}</script>

<article class="article">
  <header class="article-head">
    <div class="wrap wrap--narrow">
      <nav class="breadcrumb" aria-label="Trilha"><a href="/">AudioLab</a> · <a href="/noticias/">Notícias</a></nav>
      {% if n.data or projeto %}
      <p class="article-meta">
        {% if n.data %}<span>{{ icon("calendario", 16) }}{{ n.data | formatDate }}</span>{% endif %}
        {% if projeto %}<a href="/projetos/{{ projeto.slug }}/">{{ projeto.nome }}</a>{% endif %}
      </p>
      {% endif %}
      <h1>{{ n.titulo }}</h1>
      {% if n.subtitulo %}<p class="lead">{{ n.subtitulo }}</p>{% endif %}
    </div>
  </header>

  <div class="wrap wrap--narrow article-body">
    <div class="article-cover">{% if capa %}<img src="{{ capa }}" alt="{{ n.titulo }}" fetchpriority="high" />{% else %}{{ placeholder("[imagem 16:9]") }}{% endif %}</div>

    <div class="share-row">
      <span class="share-label">Compartilhar</span>
      <button type="button" class="icon-btn icon-btn--light" data-share="whatsapp" aria-label="Compartilhar no WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2.02c-5.52 0-10 4.48-10 10 0 1.76.46 3.48 1.34 5l-1.42 5.2 5.32-1.4a9.97 9.97 0 0 0 4.76 1.21h.01c5.52 0 10-4.48 10-10.01 0-2.67-1.04-5.18-2.93-7.07a9.94 9.94 0 0 0-7.08-2.93zm0 18.19h-.01a8.3 8.3 0 0 1-4.23-1.16l-.3-.18-3.15.83.84-3.07-.2-.32a8.32 8.32 0 0 1-1.28-4.43c0-4.6 3.74-8.34 8.34-8.34a8.28 8.28 0 0 1 5.9 2.45 8.28 8.28 0 0 1 2.44 5.9c0 4.6-3.75 8.32-8.35 8.32zm4.57-6.24c-.25-.13-1.47-.72-1.7-.81-.23-.08-.4-.13-.56.13-.17.25-.65.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23a7.5 7.5 0 0 1-1.39-1.72c-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.41 1.02 2.58.12.17 1.75 2.67 4.25 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z" /></svg>
      </button>
      <button type="button" class="icon-btn icon-btn--light" data-share="linkedin" aria-label="Compartilhar no LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
      </button>
      <button type="button" class="icon-btn icon-btn--light" data-share="copiar" aria-label="Copiar o link, para colar no Instagram">{{ socialIcon("instagram", 20) }}</button>
      <span class="share-copied" data-share-copied role="status"></span>
    </div>

    {% if n.link %}
    {% set linkHost = n.link | replace("https://", "") | replace("http://", "") | replace("www.", "") %}
    <a class="link-embed" href="{{ n.link }}" target="_blank" rel="noopener">
      <span class="link-embed-label">Saiba mais</span>
      <span class="link-embed-host">{{ linkHost.split("/")[0] }}</span>
      <span class="link-embed-cta">Acessar o link {{ icon("link-externo", 18) }}</span>
    </a>
    {% endif %}

    {% if n.corpo %}
    <div class="prose article-text">{{ n.corpo | md | safe }}</div>
    {% endif %}
  </div>
</article>

<script>
(function () {
  var url = window.location.href;
  var titulo = document.title;
  var aviso = document.querySelector("[data-share-copied]");
  var destinos = {
    whatsapp: "https://wa.me/?text=" + encodeURIComponent(titulo + " " + url),
    linkedin: "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(url)
  };
  document.querySelectorAll("[data-share]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var tipo = btn.getAttribute("data-share");
      if (destinos[tipo]) { window.open(destinos[tipo], "_blank", "noopener"); return; }
      // O Instagram não aceita link compartilhado pela web: copiamos o link.
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(url).then(function () {
        aviso.textContent = "Link copiado. Cole no Instagram.";
        setTimeout(function () { aviso.textContent = ""; }, 3000);
      }).catch(function () {});
    });
  });
})();
</script>
