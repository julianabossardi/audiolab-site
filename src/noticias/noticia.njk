---
layout: base.njk
pagination:
  data: noticias
  size: 1
  alias: n
permalink: "/noticias/{{ n.slug }}/"
eleventyComputed:
  title: "{{ n.titulo }} · AudioLab"
---
<a class="back-link" href="/">‹ AudioLab</a>

{% if n.capa %}<img class="cover" src="{{ n.capa }}" alt="" />{% endif %}
{% if n.data %}<span class="tag-pill">{{ n.data | formatDate }}</span>{% endif %}
<h1>{{ n.titulo }}</h1>
<p class="lead">{{ n.subtitulo }}</p>

<div class="share-row">
  <span class="share-label">Compartilhar</span>
  <a class="share-btn" href="#" data-share="whatsapp" target="_blank" rel="noopener" aria-label="Compartilhar no WhatsApp">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2.02c-5.52 0-10 4.48-10 10 0 1.76.46 3.48 1.34 5l-1.42 5.2 5.32-1.4a9.97 9.97 0 0 0 4.76 1.21h.01c5.52 0 10-4.48 10-10.01 0-2.67-1.04-5.18-2.93-7.07a9.94 9.94 0 0 0-7.08-2.93zm0 18.19h-.01a8.3 8.3 0 0 1-4.23-1.16l-.3-.18-3.15.83.84-3.07-.2-.32a8.32 8.32 0 0 1-1.28-4.43c0-4.6 3.74-8.34 8.34-8.34a8.28 8.28 0 0 1 5.9 2.45 8.28 8.28 0 0 1 2.44 5.9c0 4.6-3.75 8.32-8.35 8.32zm4.57-6.24c-.25-.13-1.47-.72-1.7-.81-.23-.08-.4-.13-.56.13-.17.25-.65.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23a7.5 7.5 0 0 1-1.39-1.72c-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08 0 1.23.89 2.41 1.02 2.58.12.17 1.75 2.67 4.25 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z" /></svg>
  </a>
  <a class="share-btn" href="#" data-share="linkedin" target="_blank" rel="noopener" aria-label="Compartilhar no LinkedIn">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
  </a>
  <button type="button" class="share-btn" data-share="instagram" aria-label="Copiar link para compartilhar no Instagram">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" /></svg>
  </button>
  <span class="share-copied" data-share-copied hidden>Link copiado. Cole no Instagram</span>
</div>

{% if n.link %}
<p><a class="btn" href="{{ n.link }}" target="_blank" rel="noopener">Ler matéria completa</a></p>
{% endif %}

{% if n.corpo %}
<div>{{ n.corpo | safe }}</div>
{% endif %}

<style>
  .share-row { display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin: 0 0 28px; }
  .share-label { font-family: var(--font-body); font-size: var(--fs-small); color: rgba(17, 48, 63, 0.6); margin-right: 4px; }
  .share-btn {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    border: 1px solid var(--petrol-200);
    background: rgba(2, 69, 103, 0.06);
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease-out, border-color 0.2s ease-out;
  }
  .share-btn svg { width: 18px; height: 18px; }
  .share-btn:hover { background: rgba(2, 69, 103, 0.14); border-color: rgba(2, 69, 103, 0.6); }
  .share-copied { font-family: var(--font-body); font-size: var(--fs-small); color: var(--lime-deep); }
  @media (max-width: 480px) {
    .share-label { display: none; }
  }
</style>

<script>
(function () {
  var url = window.location.href;
  var title = document.title;
  var wa = document.querySelector('[data-share="whatsapp"]');
  var li = document.querySelector('[data-share="linkedin"]');
  var ig = document.querySelector('[data-share="instagram"]');
  var copiedMsg = document.querySelector('[data-share-copied]');
  if (wa) wa.href = "https://wa.me/?text=" + encodeURIComponent(title + " " + url);
  if (li) li.href = "https://www.linkedin.com/sharing/share-offsite/?url=" + encodeURIComponent(url);
  if (ig) {
    /* Instagram has no web share-intent for arbitrary links, so the best
       we can do is copy the link and tell people to paste it there */
    ig.addEventListener("click", function () {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(url).then(function () {
        if (!copiedMsg) return;
        copiedMsg.hidden = false;
        setTimeout(function () { copiedMsg.hidden = true; }, 2500);
      }).catch(function () {
        /* clipboard permission denied or unavailable — nothing more we can do */
      });
    });
  }
})();
</script>
