{% from "al-macros.njk" import icon, socialIcon %}
{% set emProjeto = page.url.startsWith("/projetos/") %}
{% set redesLab = [
  ["instagram", "Instagram", laboratorio.lab_link_instagram],
  ["youtube", "YouTube", laboratorio.lab_link_youtube],
  ["spotify", "Spotify", laboratorio.revista_link_spotify],
  ["email", "E-mail", "mailto:" + laboratorio.lab_email if laboratorio.lab_email]
] %}
{% macro redes(classe, lista) %}
<ul class="{{ classe }}">
  {% for r in lista %}{% if r[2] %}
  <li><a class="icon-btn" href="{{ r[2] }}"{% if r[0] != "email" %} target="_blank" rel="noopener"{% endif %} aria-label="{{ r[1] }} do AudioLab">{{ socialIcon(r[0]) }}</a></li>
  {% endif %}{% endfor %}
</ul>
{% endmacro %}

<noscript><style>.highlight, [data-reveal] { opacity: 1 !important; background-size: 100% 100% !important; transform: none !important; }</style></noscript>

<header class="site-header">
  <a class="brand-logo" href="/" aria-label="AudioLab, página inicial">
    <img src="/assets/img/logo-audiolab-wide.png" alt="" width="260" height="128" />
  </a>

  <nav class="main-nav" aria-label="Principal">
    <ul class="main-nav-list">
      <li><a class="nav-link" href="/sobre/"{% if page.url == "/sobre/" %} aria-current="page"{% endif %}>Sobre</a></li>
      <li class="nav-item">
        <button type="button" class="nav-link{% if emProjeto %} is-active{% endif %}" data-nav-toggle aria-expanded="false" aria-controls="menu-projetos">
          Projetos {{ icon("seta-baixo", 14) }}
        </button>
        <ul class="nav-dropdown" id="menu-projetos" hidden>
          {% for proj in projetos %}
          <li><a href="/projetos/{{ proj.slug }}/"{% if page.url == "/projetos/" + proj.slug + "/" %} aria-current="page"{% endif %}>{{ proj.nome }}</a></li>
          {% endfor %}
          <li class="nav-dropdown-all"><a href="/projetos/"{% if page.url == "/projetos/" %} aria-current="page"{% endif %}>Ver todos os projetos {{ icon("seta", 16) }}</a></li>
        </ul>
      </li>
      <li><a class="nav-link" href="/pesquisa-e-formacao/"{% if page.url == "/pesquisa-e-formacao/" %} aria-current="page"{% endif %}>Pesquisa e formação</a></li>
    </ul>
  </nav>

  <div class="header-right">
    <button type="button" class="nav-cta" data-open-newsletter>
      <span class="nl-full">{{ cabecalho.newsletter_texto }}</span>
      <span class="nl-short">{{ cabecalho.newsletter_texto_curto }}</span>
    </button>
    {{ redes("icon-list", redesLab) }}
    <a class="header-partner" href="{{ laboratorio.lab_link_fcs or 'https://www.fcs.uerj.br/' }}" target="_blank" rel="noopener" aria-label="Faculdade de Comunicação Social da UERJ">
      <img src="/assets/img/logo-uerj-fcs.png" alt="" width="300" height="93" />
    </a>
  </div>

  <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="menu-gaveta" aria-label="Abrir menu">
    <span class="menu-toggle-open">{{ icon("menu", 24) }}</span>
    <span class="menu-toggle-close">{{ icon("fechar", 24) }}</span>
  </button>
</header>

<div class="nav-drawer" id="menu-gaveta" hidden>
  <nav aria-label="Principal no celular">
    <ul class="drawer-list">
      <li><a class="drawer-link" href="/sobre/"{% if page.url == "/sobre/" %} aria-current="page"{% endif %}>Sobre</a></li>
      <li>
        <button type="button" class="drawer-link drawer-toggle" data-drawer-toggle aria-expanded="{{ 'true' if emProjeto else 'false' }}" aria-controls="gaveta-projetos">
          Projetos {{ icon("seta-baixo", 20) }}
        </button>
        <ul class="drawer-sublist" id="gaveta-projetos"{% if not emProjeto %} hidden{% endif %}>
          {% for proj in projetos %}
          <li><a href="/projetos/{{ proj.slug }}/"{% if page.url == "/projetos/" + proj.slug + "/" %} aria-current="page"{% endif %}>{{ proj.nome }}</a></li>
          {% endfor %}
          <li><a class="drawer-all" href="/projetos/"{% if page.url == "/projetos/" %} aria-current="page"{% endif %}>Ver todos os projetos {{ icon("seta", 16) }}</a></li>
        </ul>
      </li>
      <li><a class="drawer-link" href="/pesquisa-e-formacao/"{% if page.url == "/pesquisa-e-formacao/" %} aria-current="page"{% endif %}>Pesquisa e formação</a></li>
      <li><a class="drawer-link" href="/noticias/"{% if page.url.startsWith("/noticias/") %} aria-current="page"{% endif %}>Notícias</a></li>
    </ul>
  </nav>
  <button type="button" class="nav-cta drawer-cta" data-open-newsletter>{{ cabecalho.newsletter_texto }}</button>
  {{ redes("icon-list drawer-social", redesLab) }}
  <img class="drawer-partner" src="/assets/img/logo-uerj-fcs.png" alt="UERJ · Faculdade de Comunicação Social" width="300" height="93" />
</div>

<script>
(function () {
  // Submenu Projetos (desktop)
  var toggles = document.querySelectorAll("[data-nav-toggle]");
  function closeDropdowns() {
    toggles.forEach(function (b) {
      b.setAttribute("aria-expanded", "false");
      document.getElementById(b.getAttribute("aria-controls")).hidden = true;
    });
  }
  toggles.forEach(function (btn) {
    var menu = document.getElementById(btn.getAttribute("aria-controls"));
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var open = btn.getAttribute("aria-expanded") === "true";
      closeDropdowns();
      if (!open) {
        menu.hidden = false;
        btn.setAttribute("aria-expanded", "true");
      }
    });
    btn.parentElement.addEventListener("focusout", function (e) {
      if (!btn.parentElement.contains(e.relatedTarget)) closeDropdowns();
    });
  });
  document.addEventListener("click", closeDropdowns);

  // Gaveta do celular
  var menuBtn = document.querySelector("[data-menu-toggle]");
  var drawer = document.getElementById("menu-gaveta");
  function setDrawer(open) {
    drawer.hidden = !open;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    document.documentElement.classList.toggle("menu-open", open);
  }
  menuBtn.addEventListener("click", function () { setDrawer(drawer.hidden); });
  drawer.querySelectorAll("[data-drawer-toggle]").forEach(function (btn) {
    var lista = document.getElementById(btn.getAttribute("aria-controls"));
    btn.addEventListener("click", function () {
      var aberto = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!aberto));
      lista.hidden = aberto;
    });
  });
  drawer.addEventListener("click", function (e) { if (e.target.closest("a, [data-open-newsletter]")) setDrawer(false); });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", function (e) { if (e.matches) setDrawer(false); });

  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    var openToggle = document.querySelector('[data-nav-toggle][aria-expanded="true"]');
    closeDropdowns();
    if (openToggle) openToggle.focus();
    if (!drawer.hidden) { setDrawer(false); menuBtn.focus(); }
  });
})();
</script>
