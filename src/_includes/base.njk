<!doctype html>
<html lang="pt-BR">
  <head>
    {% set tituloPagina = title or "AudioLab" %}
    {% set descricaoPagina = (description or laboratorio.lab_descricao_curta) | resumo %}
    {% set imagemCaminho = (image | img) if image else "/assets/img/og-default.png" %}
    {% set imagemPagina = imagemCaminho if imagemCaminho.startsWith("http") else site.url + imagemCaminho %}
    {% set urlPagina = site.url + page.url %}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ tituloPagina }}</title>
    <meta name="description" content="{{ descricaoPagina }}" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href="{{ urlPagina }}" />
    <link rel="alternate" type="application/rss+xml" title="Notícias do AudioLab" href="/noticias/feed.xml" />
    <link rel="icon" href="/assets/img/logo-audiolab-sm.webp" />
    <link rel="stylesheet" href="/assets/css/audiolab-tokens.css" />
    <link rel="stylesheet" href="/assets/css/site.css" />

    <!-- Open Graph / Twitter Card: como o link aparece ao ser compartilhado -->
    <meta property="og:type" content="{{ ogTipo or 'website' }}" />
    {% if publicado %}<meta property="article:published_time" content="{{ publicado }}" />{% endif %}
    <meta property="og:site_name" content="AudioLab" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content="{{ urlPagina }}" />
    <meta property="og:title" content="{{ tituloPagina }}" />
    <meta property="og:description" content="{{ descricaoPagina }}" />
    <meta property="og:image" content="{{ imagemPagina }}" />
    <meta property="og:image:alt" content="{{ tituloPagina }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ tituloPagina }}" />
    <meta name="twitter:description" content="{{ descricaoPagina }}" />
    <meta name="twitter:image" content="{{ imagemPagina }}" />

    <!-- Dados estruturados: o AudioLab como organização e o site -->
    <script type="application/ld+json">{{ {
      "@context": "https://schema.org",
      "@graph": [
        { "@type": "EducationalOrganization", "@id": site.url + "/#organizacao", "name": "AudioLab", "alternateName": laboratorio.lab_nome_completo, "url": site.url + "/", "logo": site.url + "/assets/img/logo-audiolab-lg.webp", "email": laboratorio.lab_email, "foundingDate": laboratorio.lab_desde, "sameAs": [laboratorio.lab_link_instagram, laboratorio.lab_link_youtube, laboratorio.lab_link_tiktok, laboratorio.lab_link_linkedin, laboratorio.revista_link_spotify, laboratorio.lab_link_fcs] | select },
        { "@type": "WebSite", "@id": site.url + "/#site", "url": site.url + "/", "name": "AudioLab", "inLanguage": "pt-BR", "publisher": { "@id": site.url + "/#organizacao" } }
      ]
    } | json | safe }}</script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RWPM0B14KT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RWPM0B14KT');
    </script>
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    {% include "site-header.njk" %}

    <main id="conteudo"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
      {{ content | safe }}
    </main>

    {% include "site-footer.njk" %}
    {% include "newsletter-modal.njk" %}
    {% include "newsletter-script.njk" %}
    {% include "reveal-script.njk" %}
    {% include "eq-script.njk" %}
    {% include "carousel-script.njk" %}
  </body>
</html>
