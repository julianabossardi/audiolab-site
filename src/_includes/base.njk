<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "AudioLab" }}</title>
    <meta name="description" content="{{ description or laboratorio.lab_nome_completo }}" />
    <link rel="icon" href="/assets/img/logo-audiolab-sm.webp" />
    <link rel="stylesheet" href="/assets/css/audiolab-tokens.css" />
    <link rel="stylesheet" href="/assets/css/site.css" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RWPM0B14KT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-RWPM0B14KT');
    </script>
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    {% include "site-header.njk" %}

    <main id="conteudo"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
      {{ content | safe }}
    </main>

    {% include "site-footer.njk" %}
    {% include "newsletter-modal.njk" %}
    {% include "newsletter-script.njk" %}
    {% include "reveal-script.njk" %}
    {% include "eq-script.njk" %}
    {% include "carousel-script.njk" %}
  </body>
</html>
