<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "AudioLab" }}</title>
    <link rel="icon" href="/assets/img/logo-audiolab-sm.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/site.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand-logo" href="/" aria-label="AudioLab — início">
        <img src="/assets/img/logo-audiolab-sm.webp" alt="AudioLab" />
      </a>
      <nav class="main-nav">
        <a class="nav-link{% if page.url == '/sobre/' %} is-active{% endif %}" href="/sobre/">Sobre</a>
        <a class="nav-link{% if page.url == '/formacao/' %} is-active{% endif %}" href="/formacao/">Educacional</a>
      </nav>
      <div class="header-partner">
        <img src="/assets/img/logo-uerj-fcs.png" alt="UERJ · Faculdade de Comunicação Social" />
      </div>
    </header>

    <main class="content">{{ content | safe }}</main>

    <footer class="site-footer">
      <span>Rua São Francisco Xavier, 524 — Pavilhão João Lyra Filho, sala 9.017 · Rio de Janeiro, RJ</span>
      <span class="meta">
        <a href="mailto:audiolab@fcs.uerj.br">audiolab@fcs.uerj.br</a>
        <span>FCS / UERJ</span>
        <a href="/admin/">editar conteúdo →</a>
      </span>
    </footer>
  </body>
</html>
