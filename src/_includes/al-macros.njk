{% macro socialIcon(name, size=20) %}{% if name == "email" %}<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M3 5h18v14H3z M3 6l9 7 9-7"></path></svg>{% else %}<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{ alSocialPaths[name] }}"></path></svg>{% endif %}{% endmacro %}

{# Espaço marcado no lugar de imagem ausente (DSM): nunca ícone quebrado. #}
{% macro placeholder(label, ratio="16-9") %}<div class="dsm-placeholder ratio-{{ ratio }}" role="img" aria-label="Imagem a definir">{{ label }}</div>{% endmacro %}

{# Placa do projeto: logo quando existe, senão a sigla no quadrado de cor. #}
{% macro projectMark(b, logo, nome, size="md") %}{% set src = logo or b.logo %}{% if src %}<span class="project-mark project-mark--{{ size }} has-logo" style="--mark-bg: {{ b.logoBg }};"><img src="{{ src }}" alt="{{ nome }}" /></span>{% else %}<span class="project-mark project-mark--{{ size }}" aria-hidden="true">{{ b.sigla }}</span>{% endif %}{% endmacro %}

{# Faixa de equalizador em largura total, igual à da home. Decorativa. #}
{% macro equalizer(cols=56, size="lg") %}<div class="eq-zone eq-zone--{{ size }}" data-eq aria-hidden="true"><div class="eq">{% for i in range(0, cols) %}<span class="eq-col"><i style="height: {{ 30 + (i * 47) % 70 }}%; animation-duration: {{ (3.4 + (i % 7) * 0.55) | round(2) }}s; animation-delay: {{ ((i % 11) * 0.32) | round(2) }}s;"></i></span>{% endfor %}</div></div>{% endmacro %}

{# Card de projeto (DSM): faixa de 8 px na cor, logo ou sigla, nome em h3,
   categoria, frase de resumo e "Conhecer o projeto". Mesmo tamanho para
   todos; a cor vem de data-project. #}
{% macro projectCard(proj) %}{% set b = proj.nome | brand %}
<article class="project-card" data-project="{{ b.key }}">
  {{ projectMark(b, proj.logo | img, proj.nome) }}
  <h3 class="project-card-title"><a href="/projetos/{{ proj.slug }}/">{{ proj.nome }}</a></h3>
  {% if proj.tag %}<span class="project-card-tag">{{ proj.tag }}</span>{% endif %}
  {% if proj.tagline %}<p class="project-card-text">{{ proj.tagline }}</p>{% endif %}
  <span class="project-card-link" aria-hidden="true">Conhecer o projeto {{ icon("seta", 18) }}</span>
</article>
{% endmacro %}
