---
layout: base.njk
title: Notícias · AudioLab
description: "Acompanhe as notícias e produções do AudioLab, o Laboratório de Áudio da Faculdade de Comunicação Social da UERJ."
---
{% from "al-macros.njk" import icon, placeholder, equalizer %}
{% set temas = ["Educação e ciência", "Jornalismo", "Cultura", "Esporte"] %}

<section class="page-hero">
  <div class="wrap page-hero-inner">
    <nav class="breadcrumb" aria-label="Trilha"><a href="/">AudioLab</a> · <span aria-current="page">Notícias</span></nav>
    <h1>Notícias</h1>
  </div>
  {{ equalizer(56, "md") }}
</section>

<section class="section">
  <div class="wrap">
    {% if noticias.length %}
    <div class="news-filters">
      <label class="field">
        <span>Projeto</span>
        <select data-filtro="projeto">
          <option value="">Todos os projetos</option>
          {% for p in projetos %}<option value="{{ p.slug }}">{{ p.nome }}</option>{% endfor %}
        </select>
      </label>
      <label class="field">
        <span>Tema</span>
        <select data-filtro="tema">
          <option value="">Todos os temas</option>
          {% for t in temas %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
        </select>
      </label>
    </div>

    <ul class="news-list" id="lista-noticias">
      {% for n in noticias %}
      {% set capa = n.capa | img %}
      <li class="news-row" data-projeto="{{ n.projeto_relacionado or '' }}" data-tema="{{ n.tema or '' }}">
        <div class="news-row-img">{% if capa %}<img src="{{ capa }}" alt="" />{% else %}{{ placeholder("[imagem 16:9]") }}{% endif %}</div>
        <div class="news-row-body">
          <h2><a href="/noticias/{{ n.slug }}/">{{ n.titulo }}</a></h2>
          {% if n.subtitulo %}<p>{{ n.subtitulo }}</p>{% endif %}
          {% if n.data %}<span class="news-date">{{ icon("calendario", 16) }}{{ n.data | formatDate }}</span>{% endif %}
          <span class="link-arrow" aria-hidden="true">Ler a notícia {{ icon("seta", 16) }}</span>
        </div>
      </li>
      {% endfor %}
    </ul>
    <p class="empty-state" id="noticias-vazio" role="status" hidden>Nenhuma notícia encontrada com esses filtros.</p>
    {% else %}
    <p class="empty-state">Nenhuma notícia publicada no momento.</p>
    {% endif %}
  </div>
</section>

<script>
(function () {
  var selects = document.querySelectorAll("[data-filtro]");
  var itens = document.querySelectorAll("#lista-noticias .news-row");
  var vazio = document.getElementById("noticias-vazio");
  if (!selects.length) return;
  function aplicar() {
    var f = {};
    selects.forEach(function (s) { f[s.getAttribute("data-filtro")] = s.value; });
    var visiveis = 0;
    itens.forEach(function (li) {
      var mostra = (!f.projeto || li.getAttribute("data-projeto") === f.projeto) && (!f.tema || li.getAttribute("data-tema") === f.tema);
      li.hidden = !mostra;
      if (mostra) visiveis++;
    });
    vazio.hidden = visiveis > 0;
  }
  selects.forEach(function (s) { s.addEventListener("change", aplicar); });
})();
</script>
