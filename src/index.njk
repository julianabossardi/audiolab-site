---
title: AudioLab — Laboratório de Áudio FCS/UERJ
---
{% macro projectNode(src, alt, tagText, animClass, isEscola, href) %}
<a class="project-node {{ animClass }}{% if isEscola %} is-escola{% endif %}" href="{{ href if href else '/projetos/' }}">
  <span class="bubble project-bubble"><img src="{{ src }}" alt="{{ alt }}" /></span>
  <span class="tag-chip">{{ tagText }}</span>
</a>
{% endmacro %}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
<meta name="description" content="AudioLab — Laboratório de Áudio da Faculdade de Comunicação Social da UERJ." />
<link rel="icon" href="/assets/img/logo-audiolab-sm.webp" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500;600;700&family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/assets/css/site.css" />
<style>
  :root {
    --bubble-d: clamp(70px, 9.85vw, 116px); /* -5% */
    /* was doubled — that overshot past the fold on web and ran long on
       mobile, dialed back. The 320px floor isn't arbitrary: bubble top
       (14%) + bubble height + the staggered tags + the arrow all have
       to stack without collision below 760px, and that stack needs
       ~320px of room at the current sizes. */
    --zone-h: clamp(340px, 30vw, 380px); /* web — do not touch, already dialed in */
  }
  html, body { margin: 0; padding: 0; }
  body { background: var(--navy); }

  .page-wrap { position: relative; padding-bottom: var(--footer-h); }

  /* diagonal green wash tying the hero into the news section below it */
  .diagonal-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to bottom left, rgba(4, 72, 52, 0.72) 0%, rgba(6, 90, 64, 0.52) 18%, rgba(8, 110, 78, 0.28) 38%, transparent 62%);
  }

  /* ── hero ───────────────────────────────────────────── */
  .hero-section {
    position: relative;
    z-index: 3;
    overflow: hidden;
    min-height: calc(100vh - var(--footer-h));
    display: flex;
    flex-direction: column;
  }
  .hero-text-wrap {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 5;
    padding: calc(var(--header-h) + 56px) 6vw 24px 6vw;
  }
  .hero-headline { margin: 0; font-family: var(--font-heading); font-weight: 700; line-height: 1.08; letter-spacing: -0.01em; }
  .hline { display: block; font-size: clamp(2rem, 5.5vw, 6.2rem); }
  .hline-1 { animation: hero-line-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both; }
  .hline-2 { animation: hero-line-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.38s both; }
  .hline-3 { animation: hero-line-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.62s both; }
  @keyframes hero-line-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  /* two headline builds: desktop keeps "AudioLab é a UERJ / em todo
     lugar"; mobile re-wraps to a shorter 3rd line so nothing gets
     tight — only one is ever in the layout, the other is display:none */
  .hero-desktop { display: block; }
  .hero-mobile { display: none; }
  @media (max-width: 760px) {
    .hero-desktop { display: none; }
    .hero-mobile { display: block; }
  }
  .grad-text {
    background: linear-gradient(110deg, rgba(61, 224, 192, 1) 0%, rgba(120, 255, 220, 1) 55%, rgba(61, 210, 180, 1) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 28px rgba(61, 224, 192, 0.25));
  }
  .white-italic { color: #fff; font-style: italic; filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.15)); }

  @media (max-width: 640px) {
    /* the extra top gap above is a web-only tweak — keep mobile as it was */
    .hero-text-wrap { padding-top: calc(var(--header-h) + 32px); padding-left: 24px; padding-right: 24px; }
  }

  /* ── waveform zone ──────────────────────────────────── */
  .wave-zone { position: relative; height: var(--zone-h); flex: 0 0 auto; z-index: 5; }
  .wave-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  .bubble {
    border-radius: 50%;
    background: rgba(2, 54, 82, 0.28);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1.5px solid rgba(61, 224, 192, 0.5);
    box-shadow: 0 0 20px rgba(61, 224, 192, 0.1), 0 3px 14px rgba(0, 0, 0, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(26, 184, 160, 0.8);
    transition: all 0.35s;
  }
  .bubble:hover, .bubble:focus-visible {
    border-color: rgba(100, 240, 210, 0.75);
    box-shadow: 0 0 30px rgba(61, 224, 192, 0.22), 0 4px 18px rgba(0, 0, 0, 0.36);
    background: rgba(2, 54, 82, 0.5);
    color: rgba(100, 240, 210, 1);
    transform: scale(1.08);
  }
  .tag-chip {
    position: relative;
    z-index: 2;
    margin-top: -10px;
    background: rgba(1, 24, 38, 0.92);
    border: 1px solid rgba(61, 224, 192, 0.4);
    border-radius: 3px;
    padding: 5px 14px;                 /* +25% */
    font-size: clamp(11px, 1.25vw, 14px); /* +25% */
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(100, 240, 210, 0.88);
    font-family: var(--font-body);
    white-space: nowrap;
    pointer-events: none;
    max-width: 30vw;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 760px) {
    /* the tags need to read in full on mobile — give them much more
       room than the desktop safety cap allows (the actual anti-overlap
       protection there is now each node's own staggered height below) */
    .tag-chip { font-size: 11.5px; padding: 5px 15px; max-width: 62vw; white-space: normal; text-align: center; }
  }

  .project-node {
    position: absolute;
    top: 14%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transform: translateX(-50%);
  }
  /* fixed x per bubble — plain classes, not an inline custom property,
     so the mobile media query below can actually override them (a
     custom property set via style="" always wins over any stylesheet
     rule, media query or not, so that approach silently never worked) */
  .node-a { left: 20%; animation: float-a 3.2s ease-in-out 0s infinite; }
  .node-b { left: 50%; animation: float-b 3.8s ease-in-out 0.9s infinite; }
  .node-c { left: 76%; animation: float-c 4.4s ease-in-out 1.7s infinite; }
  .project-node .bubble { width: var(--bubble-d); height: var(--bubble-d); }
  .project-node img { width: 78%; height: 78%; object-fit: contain; }
  .project-node.is-escola img { filter: brightness(0) invert(1); }
  @keyframes float-a { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-8px); } }
  @keyframes float-b { 0%, 100% { transform: translateX(-50%) translateY(-4px); } 50% { transform: translateX(-50%) translateY(4px); } }
  @keyframes float-c { 0%, 100% { transform: translateX(-50%) translateY(-2px); } 50% { transform: translateX(-50%) translateY(-9px); } }
  @media (max-width: 760px) {
    /* mobile needs a taller zone than web — the three nodes now stack
       down the height of it (see below), each with room to show its
       full tag text, plus the arrow underneath all three */
    :root { --zone-h: 680px; }
    .node-a { left: 16%; }
    .node-c { left: 84%; }
    /* the tag now stays attached right under its own bubble (the base
       -10px from .tag-chip) — instead of pulling the *tag* away from
       its bubble, each whole node (bubble+tag together) sits at a
       different height, which is also what makes room for the full,
       untruncated label above */
    .node-a { top: 10%; }
    .node-b { top: 36%; }
    .node-c { top: 62%; }
  }
  @media (max-width: 340px) {
    /* very narrow phones (e.g. 320px) don't have room for the Escola
       bubble to clear the social rail at the regular mobile size —
       shrink every bubble a bit more for clearance */
    :root { --bubble-d: 60px; }
  }

  .arrow-node {
    position: absolute;
    right: 4%;
    top: 54%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: opacity 0.3s;
    animation: float-arrow 3.6s ease-in-out 0.4s infinite;
  }
  .arrow-node:hover, .arrow-node:focus-visible { opacity: 0.75; }
  .arrow-node .bubble { width: clamp(40px, 5.6vw, 50px); height: clamp(48px, 6.6vw, 59px); border-radius: 8px; }
  .arrow-node .tag-chip { margin-top: 0; border-color: rgba(61, 224, 192, 0.45); color: rgba(80, 235, 200, 1); }
  @keyframes float-arrow { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
  @keyframes float-arrow-centered { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-7px); } }
  /* node-c now sits much lower (see above, so its tag has room to show
     in full) and claims the same right-hand corner the arrow used on
     desktop — recenter the arrow under everything instead of fighting
     it for that corner. Must come after the base rule above so it
     actually wins at equal specificity. */
  @media (max-width: 760px) {
    .arrow-node { right: auto; left: 50%; top: 90%; animation-name: float-arrow-centered; }
  }

  /* ── news section ───────────────────────────────────── */
  .news-section { position: relative; z-index: 3; padding: 56px 0 64px; }
  .news-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 6vw; margin-bottom: 28px; }
  .news-head h2 { font-family: var(--font-heading); font-size: clamp(1.4rem, 2.5vw, 1.75rem); font-weight: 700; letter-spacing: -0.01em; margin: 0; color: #fff; } /* +15% */

  .news-carousel-wrap { position: relative; }
  .news-carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 0 6vw 12px;
    cursor: grab;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .news-carousel::-webkit-scrollbar { display: none; }
  .news-carousel.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .news-card {
    flex: 0 0 auto;
    width: 280px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(1, 30, 46, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-decoration: none;
    color: #fff;
    display: block;
    transition: transform 0.25s, border-color 0.25s;
  }
  .news-card:hover { transform: translateY(-4px); border-color: rgba(61, 224, 192, 0.3); }
  .news-card-img { height: 156px; overflow: hidden; background: rgba(2, 54, 82, 0.5); }
  .news-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .news-card-body { padding: 16px 18px 20px; }
  .news-card-title { font-family: var(--font-nav); font-weight: 500; font-size: 1.02rem; line-height: 1.3; margin-bottom: 8px; }
  .news-card-sub { font-family: var(--font-nav); font-size: 0.78rem; line-height: 1.55; color: rgba(255, 255, 255, 0.78); }
  .news-scroll-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-60%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(2, 54, 82, 0.8);
    border: 1px solid rgba(61, 224, 192, 0.4);
    color: rgba(100, 240, 210, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .news-scroll-btn:hover { background: rgba(2, 54, 82, 1); border-color: rgba(61, 224, 192, 0.75); }
  .news-empty { padding: 0 6vw; font-family: var(--font-nav); color: rgba(255, 255, 255, 0.6); font-size: 0.9rem; }
  .news-empty a { color: rgba(100, 240, 210, 1); }
</style>
</head>
<body>

  {% include "site-header.njk" %}

  <div class="page-wrap">
    <div class="diagonal-overlay" aria-hidden="true"></div>

    <!-- ════ SECTION 1 — HERO ════ -->
    <section class="hero-section">
      <div class="hero-text-wrap">
        <h1 class="hero-headline">
          <span class="hero-desktop">
            <span class="hline hline-1 grad-text">AudioLab é a UERJ</span>
            <span class="hline hline-2"><span class="grad-text">em </span><span class="white-italic">todo lugar</span></span>
          </span>
          <span class="hero-mobile">
            <span class="hline hline-1 grad-text">AudioLab é</span>
            <span class="hline hline-2 grad-text">a UERJ em</span>
            <span class="hline hline-3 white-italic">todo lugar</span>
          </span>
        </h1>
      </div>

      <div class="wave-zone" data-wave-zone="home">
        <canvas class="wave-canvas" data-wave-canvas></canvas>

        {% set badaProject = projetos | findByNome("BadaUERJ") %}
        {% set atelieProject = projetos | findByNome("Ateliê do Podcast") %}
        {% set escolaProject = projetos | findByNome("Escola de Narradores") %}

        {{ projectNode("/assets/img/logo-bada.webp", "BADA UERJ", "BadaUERJ", "node-a", false, ("/projetos/" + badaProject.slug + "/") if badaProject else null) }}
        {{ projectNode("/assets/img/logo-atelie.webp", "Ateliê do Podcast", "Ateliê do Podcast", "node-b", false, ("/projetos/" + atelieProject.slug + "/") if atelieProject else null) }}
        {{ projectNode("/assets/img/logo-escola.webp", "Escola de Narradores", "Escola de Narradores", "node-c", true, ("/projetos/" + escolaProject.slug + "/") if escolaProject else null) }}

        <a class="arrow-node" href="/projetos/" aria-label="Ver mais projetos">
          <span class="bubble">
            <svg width="60%" height="60%" viewBox="0 0 34 40" fill="none">
              <circle cx="13" cy="11" r="2.8" fill="rgba(100,240,210,0.95)" />
              <circle cx="20" cy="18" r="2.8" fill="rgba(100,240,210,0.95)" />
              <circle cx="13" cy="25" r="2.8" fill="rgba(100,240,210,0.95)" />
            </svg>
          </span>
          <span class="tag-chip">Mais projetos</span>
        </a>
      </div>
    </section>

    <!-- ════ SECTION 2 — NOTÍCIAS ════ -->
    <section class="news-section">
      <div class="news-head">
        <h2>Últimas notícias</h2>
        <a class="nav-link" href="/noticias/">Veja mais</a>
      </div>

      {% if noticias.length == 0 %}
      <p class="news-empty">Nenhuma notícia ainda. Abra <a href="/admin/">/admin</a> e crie a primeira.</p>
      {% else %}
      <div class="news-carousel-wrap">
        <div class="news-carousel" id="newsCarousel">
          {% for n in noticias %}
          <a class="news-card" href="{{ n.link if n.link else ('/noticias/' + n.slug + '/') }}"{% if n.link %} target="_blank" rel="noopener"{% endif %}>
            {% if n.capa %}
            <div class="news-card-img"><img src="{{ n.capa }}" alt="" /></div>
            {% endif %}
            <div class="news-card-body">
              <div class="news-card-title">{{ n.titulo }}</div>
              <div class="news-card-sub">{{ n.subtitulo }}</div>
            </div>
          </a>
          {% endfor %}
        </div>
        <button type="button" class="news-scroll-btn" id="newsScrollBtn" aria-label="Ver próximas notícias">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
        </button>
      </div>
      {% endif %}
    </section>
  </div>

  {% include "site-footer.njk" %}
  {% include "newsletter-modal.njk" %}
  {% include "newsletter-script.njk" %}

  <script>
  (function () {
    /* ── waveform ───────────────────────────────────────── */
    function createWave(zone, canvas, targetSelector) {
      var ctx = canvas.getContext && canvas.getContext("2d");
      if (!ctx) return { start: function () {} };

      var dpr = 1, W = 0, H = 0, numCols = 48, raf = null;
      var dotR = 3, dotStep = 10;
      var targets = [];

      // one teal/mint family for every column — the old palette switched
      // ambient columns to blue, which read as an inconsistent, darker
      // patch once the zone got taller and more of it was on screen
      function dotColor(frac, isPeak, isWide) {
        if (isPeak || isWide) {
          if (frac > 0.70) return "rgba(100,240,210,0.98)";
          if (frac > 0.45) return "rgba(61,224,192,0.92)";
          if (frac > 0.22) return "rgba(26,184,160,0.82)";
          return "rgba(10,122,106,0.68)";
        }
        if (frac > 0.52) return "rgba(61,224,192,0.55)";
        if (frac > 0.26) return "rgba(26,184,160,0.42)";
        return "rgba(10,122,106,0.30)";
      }

      function measure() {
        dpr = window.devicePixelRatio || 1;
        W = zone.clientWidth;
        H = zone.clientHeight;
        canvas.width = W * dpr;
        canvas.height = H * dpr;

        var s = Math.max(0.55, Math.min(1.1, H / 260));
        dotR = 3 * s;
        dotStep = Math.max(6, 10 * s);
        numCols = Math.max(26, Math.min(90, Math.round(W / 13)));

        var zr = zone.getBoundingClientRect();
        var els = targetSelector ? zone.querySelectorAll(targetSelector) : [];
        targets = Array.prototype.map.call(els, function (el) {
          var r = el.getBoundingClientRect();
          return { x: r.left + r.width / 2 - zr.left, bottom: r.bottom - zr.top };
        });
      }

      function classify(cx, colW) {
        var best = null, bestD = Infinity;
        for (var i = 0; i < targets.length; i++) {
          var d = Math.abs(cx - targets[i].x);
          if (d < bestD) { bestD = d; best = targets[i]; }
        }
        if (!best) return { kind: "plain" };
        if (bestD < colW * 1.3) return { kind: "peak", t: best };
        if (bestD < colW * 4) return { kind: "wide", t: best };
        return { kind: "plain" };
      }

      function draw(ts) {
        var t = ts / 1000;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);
        var colW = W / numCols;
        var maxDots = Math.max(1, Math.floor(H / dotStep));

        for (var col = 0; col < numCols; col++) {
          var cx = (col + 0.5) * colW;
          var c = classify(cx, colW);
          var hpx;
          if (c.kind === "peak") {
            hpx = Math.max(28, H - c.t.bottom + 16) + 7 * Math.sin(t * 0.55 + col * 0.38);
          } else if (c.kind === "wide") {
            hpx = Math.max(20, (H - c.t.bottom + 16) * 0.68) + 9 * Math.sin(t * 0.60 + col * 0.38);
          } else {
            var a = Math.sin(t * 0.78 + col * 0.21) * 0.24;
            var b = Math.sin(t * 1.35 + col * 0.16) * 0.15;
            var cc = Math.sin(t * 0.40 + col * 0.67) * 0.09;
            hpx = Math.max(0.08, Math.min(0.78, 0.38 + a + b + cc)) * H;
          }
          var activeDots = Math.max(1, Math.min(maxDots, Math.round(hpx / dotStep)));
          for (var d = 0; d < activeDots; d++) {
            var cy = H - dotR - 2 - d * dotStep;
            var frac = d / maxDots;
            ctx.fillStyle = dotColor(frac, c.kind === "peak", c.kind === "wide");
            ctx.beginPath();
            ctx.arc(cx, cy, dotR, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        raf = requestAnimationFrame(draw);
      }

      var ro = new ResizeObserver(measure);
      ro.observe(zone);

      return { start: function () { measure(); if (!raf) raf = requestAnimationFrame(draw); } };
    }

    var zone = document.querySelector("[data-wave-zone]");
    if (zone) createWave(zone, zone.querySelector("[data-wave-canvas]"), ".project-node .bubble").start();

    /* ── news carousel: drag-to-scroll + arrow button ──────── */
    var carousel = document.getElementById("newsCarousel");
    if (carousel) {
      var isDown = false, startX = 0, scrollLeft = 0, moved = false;
      carousel.addEventListener("mousedown", function (e) {
        isDown = true; moved = false;
        startX = e.pageX - carousel.offsetLeft;
        scrollLeft = carousel.scrollLeft;
        carousel.classList.add("is-dragging");
      });
      window.addEventListener("mouseup", function () { isDown = false; carousel.classList.remove("is-dragging"); });
      carousel.addEventListener("mouseleave", function () { isDown = false; carousel.classList.remove("is-dragging"); });
      carousel.addEventListener("mousemove", function (e) {
        if (!isDown) return;
        e.preventDefault();
        var x = e.pageX - carousel.offsetLeft;
        if (Math.abs(x - startX) > 4) moved = true;
        carousel.scrollLeft = scrollLeft - (x - startX);
      });
      // a drag shouldn't also fire the card's click-through link
      carousel.addEventListener("click", function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);

      var scrollBtn = document.getElementById("newsScrollBtn");
      if (scrollBtn) {
        scrollBtn.addEventListener("click", function () {
          carousel.scrollBy({ left: 320, behavior: "smooth" });
        });
      }
    }
  })();
  </script>
</body>
</html>
