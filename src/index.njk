---
layout: base.njk
title: AudioLab · Laboratório de Áudio FCS/UERJ
bodyClass: is-home
---
{% from "al-macros.njk" import icon, placeholder, projectCard, carouselControls, equalizer %}
{% set principais = projetos | principais %}
{% set destaque = noticias[0] %}
{% set outras = noticias | limit(4) %}

<!-- herói: título, frase de apoio e atalhos fixos para os três projetos principais -->
<section class="home-hero">
  <div class="wrap home-hero-grid">
    <div class="home-hero-text">
      <h1 class="home-hero-title">
        <span class="hero-desktop">AudioLab é a UERJ<br /><em>em todo lugar</em></span>
        <span class="hero-mobile">AudioLab é<br />a UERJ <em>em</em><br /><em>todo lugar</em></span>
      </h1>
      <p class="lead">{{ laboratorio.lab_nome_completo }}</p>
    </div>

    {% if principais.length %}
    <nav class="home-shortcuts" aria-label="Projetos em destaque">
      <ul class="home-shortcuts-list">
        {% for proj in principais %}
        {% set b = proj.nome | brand %}
        <li>
          <a class="home-shortcut" href="/projetos/{{ proj.slug }}/" aria-label="{{ proj.nome }}" data-project="{{ b.key }}">
            <img class="home-shortcut-logo{% if b.key == "escola" %} is-knockout{% endif %}" src="{{ b.logoBranco or b.logo }}" alt="{{ proj.nome }}" />
            <span class="home-shortcut-arrow" aria-hidden="true">{{ icon("seta", 18) }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
      <a class="home-shortcuts-all" href="/projetos/">Ver todos os projetos {{ icon("seta", 18) }}</a>
    </nav>
    {% endif %}
  </div>
  {{ equalizer(56, "lg") }}
</section>

<!-- todos os projetos em carrossel: 4 por vez, passa sozinho; os três principais primeiro -->
<section class="section" aria-labelledby="titulo-projetos" data-carousel data-passagem="3000" aria-roledescription="carrossel">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title" id="titulo-projetos"><span class="highlight">Nossos projetos</span></h2>
      <div class="section-head-actions">
        <a class="link-arrow" href="/projetos/">Ver todos os projetos {{ icon("seta", 18) }}</a>
        {% if projetos.length > 4 %}{{ carouselControls("Projetos", true) }}{% endif %}
      </div>
    </div>
    {% if projetos.length %}
    <ul class="carousel-track" data-carousel-track>
      {% for proj in projetos %}
      <li class="carousel-slide">{{ projectCard(proj, true) }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty-state">Nenhum projeto publicado no momento.</p>
    {% endif %}
  </div>
</section>

<!-- notícias: destaque grande + até duas em lista compacta -->
<section class="section" aria-labelledby="titulo-noticias">
  <div class="wrap">
    <div class="section-head">
      <h2 class="section-title" id="titulo-noticias"><span class="highlight">Últimas notícias</span></h2>
      {% if noticias.length %}<a class="link-arrow" href="/noticias/">Ver todas as notícias {{ icon("seta", 18) }}</a>{% endif %}
    </div>

    {% if destaque %}
    {% set capa = destaque.capa | img %}
    <article class="highlight-card">
      <div class="highlight-card-text">
        <span class="eyebrow">{{ icon("microfone", 16) }}Notícia</span>
        <h3><a href="{{ destaque.link if destaque.link else ('/noticias/' + destaque.slug + '/') }}"{% if destaque.link %} target="_blank" rel="noopener"{% endif %}>{{ destaque.titulo }}</a></h3>
        {% if destaque.subtitulo %}<p>{{ destaque.subtitulo }}</p>{% endif %}
        {% if destaque.data %}<span class="news-date">{{ icon("calendario", 16) }}{{ destaque.data | formatDate }}</span>{% endif %}
        <span class="link-arrow" aria-hidden="true">Ler a notícia {{ icon("seta", 18) }}</span>
      </div>
      <div class="highlight-card-img">{% if capa %}<img src="{{ capa }}" alt="" />{% else %}{{ placeholder("[imagem 16:9]") }}{% endif %}</div>
    </article>

    {% if outras.length > 1 %}
    <ul class="news-compact">
      {% for n in outras %}{% if not loop.first %}
      {% set capa = n.capa | img %}
      <li class="news-compact-item">
        <div class="news-compact-img">{% if capa %}<img src="{{ capa }}" alt="" />{% else %}{{ placeholder("[imagem 16:9]") }}{% endif %}</div>
        <div>
          <h3><a href="{{ n.link if n.link else ('/noticias/' + n.slug + '/') }}"{% if n.link %} target="_blank" rel="noopener"{% endif %}>{{ n.titulo }}</a></h3>
          {% if n.data %}<span class="news-date">{{ icon("calendario", 16) }}{{ n.data | formatDate }}</span>{% endif %}
          <span class="link-arrow" aria-hidden="true">Ler a notícia {{ icon("seta", 16) }}</span>
        </div>
      </li>
      {% endif %}{% endfor %}
    </ul>
    {% endif %}
    {% else %}
    <p class="empty-state">Nenhuma notícia publicada no momento.</p>
    {% endif %}
  </div>
</section>
